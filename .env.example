# 作者：晨星
# helios-ai-stack 环境变量样例（ARCH §6.1 全量）。
# 复制为 .env 后按需修改；所有变量前缀统一为 HELIOS_。
# 说明：本文件仅作样例，程序默认值内置于 core/config.py，未设置任何变量也能直接跑 offline 档。

# ---------- 档位与配置 ----------
HELIOS_PROFILE=offline
HELIOS_CONFIG=configs/default.yaml

# ---------- 网络闸门 ----------
# 0 = 禁止出网（offline 默认），出网即抛 E_*_NET_DISABLED
HELIOS_ALLOW_NETWORK=0

# ---------- 嵌入 ----------
HELIOS_EMBED_BACKEND=hashing
HELIOS_EMBED_MODEL=
HELIOS_EMBED_DIM=384

# ---------- 向量 ----------
HELIOS_VECTOR_BACKEND=numpy

# ---------- 词法 ----------
HELIOS_LEXICAL_BACKEND=bm25

# ---------- 重排 ----------
HELIOS_RERANK_BACKEND=lexical
HELIOS_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ---------- 生成 ----------
HELIOS_LLM_BACKEND=template
HELIOS_LLM_MODEL=
HELIOS_LLM_THREADS=4
HELIOS_LLM_CTX=4096

# ---------- 目录 ----------
HELIOS_MODEL_DIR=models/
HELIOS_DATA_DIR=data/
HELIOS_INDEX_DIR=data/index
HELIOS_CACHE_DIR=data/cache

# ---------- 外部服务 ----------
HELIOS_OLLAMA_HOST=http://127.0.0.1:11434

# ---------- 日志与超时 ----------
HELIOS_LOG_LEVEL=INFO
HELIOS_TIMEOUT_SEARCH_MS=2000
HELIOS_TIMEOUT_LLM_MS=120000
